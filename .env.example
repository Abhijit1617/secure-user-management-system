# Copy this file to .env and fill in real values before running
# `docker compose up -d`. Never commit the resulting .env file.

# --- Database -----------------------------------------------------------
DB_URL=jdbc:postgresql://postgres:5432/control_plane_db
DB_USERNAME=control_plane_user
DB_PASSWORD=change-me-to-a-real-password

# --- Redis ----------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Kafka ------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# --- JWT ---------------------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-a-real-base64-encoded-256-bit-secret
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# --- CORS / frontend ------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com

# --- SMTP ------------------------------------------------------------------------
MAIL_HOST=smtp.yourprovider.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=no-reply@yourdomain.com

# --- File storage -------------------------------------------------------------------
STORAGE_BASE_PATH=/app/storage
STORAGE_MAX_FILE_SIZE=10485760

# --- Server ------------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# --- Monitoring (Grafana) -----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-to-a-real-password
